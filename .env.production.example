# ===== KEY STREET — PRODUCCIÓN: añade esto a tu .env del servidor =====
# Parte de .env.example (secretos generados) y SOBRESCRIBE/AÑADE estas variables.
# Nunca subas el .env real a git.

# --- Transporte y sesión ---
COOKIE_SECURE=true            # la cookie del refresh token solo viaja por HTTPS
REQUIRE_HTTPS=true            # rechaza (426) la subida de PDF sin HTTPS
CORS_ALLOWED_ORIGINS=https://tu-dominio.com
RATE_LIMIT_ENABLED=true       # limita el abuso del asistente y del login

# --- Superficie expuesta ---
OPENAPI_ENABLED=false         # oculta Swagger / api-docs en producción

# --- PDFs: antivirus (arranca con: docker compose --profile security up -d) ---
CLAMAV_ENABLED=true

# --- IA ---
AI_PROVIDER=gemini
GEMINI_API_KEY=               # tu clave real (Google AI Studio); si queda vacía el asistente no responde

# --- Negocio ---
WHATSAPP_PHONE=57XXXXXXXXXX   # número real, formato internacional sin "+"
